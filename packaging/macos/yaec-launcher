#!/bin/bash
# YAEC - avvio su macOS con Mono (le finestre Windows Forms di Mono usano X11: serve XQuartz)
# I dati stanno in ~/Library/Application Support/YAEC/data
HERE="$(cd "$(dirname "$0")" && pwd)"
EXE="$HERE/../Resources/YAEC.exe"
MONO=""
for m in /Library/Frameworks/Mono.framework/Versions/Current/Commands/mono /opt/homebrew/bin/mono /usr/local/bin/mono; do
  if [ -x "$m" ]; then MONO="$m"; break; fi
done
[ -z "$MONO" ] && MONO="$(command -v mono 2>/dev/null)"
if [ -z "$MONO" ]; then
  osascript -e 'display alert "YAEC needs Mono" message "Install Mono for macOS (mono-project.com or the Framework Mono package from WineHQ) and XQuartz (xquartz.org), then open YAEC again." as critical' >/dev/null 2>&1
  open "https://www.mono-project.com/download/stable/#download-mac"
  exit 1
fi
if [ ! -d "/Applications/Utilities/XQuartz.app" ] && [ ! -d "/Applications/XQuartz.app" ]; then
  osascript -e 'display alert "YAEC needs XQuartz" message "Mono draws the YAEC window through X11. Install XQuartz (xquartz.org), log out and in again, then open YAEC." as critical' >/dev/null 2>&1
  open "https://www.xquartz.org"
  exit 1
fi
export MONO_MWF_MAC_FORCE_X11=1
[ -z "$DISPLAY" ] && export DISPLAY=:0
# avviato dal Finder XQuartz può non essere ancora in esecuzione: lo apre e aspetta il suo socket (fino a 20 s)
if [ ! -S /tmp/.X11-unix/X0 ]; then
  open -a XQuartz >/dev/null 2>&1
  for i in $(seq 1 40); do [ -S /tmp/.X11-unix/X0 ] && break; sleep 0.5; done
fi
DATA="$HOME/Library/Application Support/YAEC/data"
mkdir -p "$DATA"
LOG="$DATA/mono-log.txt"
# diagnostica: architettura del Mac e del Mono installato (lo script "mono" del framework avvia mono-sgen64), Rosetta, quarantena
MAC=$(uname -m)
REAL="$MONO"; D="$(dirname "$MONO")"
for b in "$D/mono-sgen64" "$D/../bin/mono-sgen64" "$D/mono-sgen"; do [ -f "$b" ] && { REAL="$b"; break; }; done
ARCHS=$(lipo -archs "$REAL" 2>/dev/null || file -b "$REAL" 2>/dev/null)
ROSETTA=no; { [ -f /Library/Apple/usr/share/rosetta/rosetta ] || /usr/bin/pgrep -q oahd 2>/dev/null; } && ROSETTA=yes
{
  echo "--- $(date) · macOS $(sw_vers -productVersion 2>/dev/null) · Mac $MAC · Rosetta $ROSETTA · DISPLAY=$DISPLAY"
  echo "mono: $MONO -> $REAL [$ARCHS] · $("$MONO" --version 2>&1 | head -1)"
  echo "app: $EXE · quarantine: $(xattr -p com.apple.quarantine "$HERE/../.." 2>/dev/null || echo none)"
} >>"$LOG" 2>&1
RUN=("$MONO")
# Mac Apple Silicon con un Mono solo Intel: serve Rosetta (se c'è, si avvia Mono sotto Rosetta)
if [ "$MAC" = "arm64" ] && [ -n "$ARCHS" ] && ! echo "$ARCHS" | grep -q arm64; then
  if [ "$ROSETTA" = no ]; then
    osascript -e 'display alert "YAEC needs Rosetta or a newer Mono" message "The Mono installed on this Mac is for Intel processors only. Either install Rosetta (Terminal: softwareupdate --install-rosetta --agree-to-license) or install the current universal Mono (Framework Mono package from WineHQ), then open YAEC again." as critical' >/dev/null 2>&1
    open "https://gitlab.winehq.org/mono/mono/-/releases"
    exit 1
  fi
  RUN=(arch -x86_64 "$MONO")
fi
"${RUN[@]}" "$EXE" "$@" >>"$LOG" 2>&1
RC=$?
echo "exit code $RC" >>"$LOG"
if [ $RC -eq 126 ] || [ $RC -eq 127 ]; then
  # 126/127: macOS non ha potuto eseguire Mono (permessi, processore sbagliato, Mono incompleto)
  osascript -e "display alert \"YAEC could not run Mono (code $RC)\" message \"macOS refused to run $MONO. Reinstall the current Mono (Framework Mono package from WineHQ). On Apple Silicon Macs with an Intel-only Mono also install Rosetta (Terminal: softwareupdate --install-rosetta --agree-to-license). Details are in ~/Library/Application Support/YAEC/data/mono-log.txt: please send that file to the author.\" as critical" >/dev/null 2>&1
  open -R "$LOG"
elif [ $RC -ne 0 ]; then
  osascript -e "display alert \"YAEC did not start (code $RC)\" message \"Details are in ~/Library/Application Support/YAEC/data/mono-log.txt. Please send that file to the author.\" as critical" >/dev/null 2>&1
  open -R "$LOG"
fi
exit $RC
